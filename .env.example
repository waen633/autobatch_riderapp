# MongoDB
MONGO_URI=mongodb://user:pass@host:27017

# Server
PORT=3000
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
SESSION_SECRET=replace-with-random-session-secret

# Keycloak
# Local Keycloak setup
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=autobatch
KEYCLOAK_CLIENT_ID=autobatch-dashboard
KEYCLOAK_CLIENT_SECRET=replace-with-dashboard-client-secret
KEYCLOAK_ISSUER=http://localhost:8080/realms/autobatch
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/autobatch/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=autobatch-dashboard
KEYCLOAK_ADMIN_ROLE=admin
KEYCLOAK_USER_ROLE=user
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASS=replace-with-keycloak-admin-password

# Confidential service account client for server-side Keycloak Admin REST calls.
# Do not expose this client or secret to the frontend.
KEYCLOAK_ADMIN_CLIENT_ID=autobatch-admin-service
KEYCLOAK_ADMIN_CLIENT_SECRET=replace-with-service-account-secret

# Tencent CLS (job diagnostics)
CLS_SECRET_ID=
CLS_SECRET_KEY=
CLS_REGION=ap-singapore
CLS_TOPIC_NAME=allnow-prod-log
CLS_TOPIC_ID=

# Google Sheets Sync
SYNC_STORE_CODES=1104,5022,6403
GOOGLE_SHEET_ID=1DwuLwDs4R1gbfedB7LWoJ6NQHac5VLBJQJ0RGCPJYgk
SYNC_SHEET_NAME=rider_queue
GOOGLE_SERVICE_ACCOUNT_EMAIL=google-autobatch-sheet@vaulted-bus-453914-e4.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# AI Chat (Phase 2) — OpenRouter
