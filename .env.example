# AI Chat (Phase 2) — OpenRouter
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxx
# เปลี่ยน model ได้ เช่น anthropic/claude-3-haiku หรือ qwen/qwen-2.5-7b-instruct:free
AI_MODEL=anthropic/claude-3-haiku

# ─── Keycloak (Phase 4) ──────────────────────────────────────────────────────
# URL ของ Keycloak server (local dev ใช้ http://localhost:8080)
KEYCLOAK_URL=http://localhost:8080
# Realm ที่สร้างใน Keycloak Admin Console
KEYCLOAK_REALM=autobatch
# Client ID ที่สร้างใน Keycloak (OpenID Connect, confidential)
KEYCLOAK_CLIENT_ID=autobatch-dashboard
# Client Secret — copy จาก Keycloak > Client > Credentials
KEYCLOAK_CLIENT_SECRET=
# URL ของ dashboard เอง (ใช้ redirect callback)
APP_URL=http://localhost:3000
# Session secret — ใส่ random string ยาว ๆ (openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-long-random-string
